  "info": {
    "_postman_id": "e940d618-ff14-489d-af78-a979a1e72f3c",
    "name": "Apache Oozie REST Jobs API",
    "description": "The Oozie Web Services API provides REST endpoints for submitting, managing, and monitoring workflow, coordinator, and bundle jobs on Apache Hadoop. The API supports job lifecycle management (submit, start, suspend, resume, kill, rerun), status monitoring, log retrieval, DAG visualization, and system administration. Authentication is handled by the Hadoop security layer (Kerberos or SPNEGO when security is enabled).\n\nContact Support:\n Name: Apache Oozie",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T01:18:59.000Z",
    "updatedAt": "2026-10-22T01:19:00.000Z",
    "lastUpdatedBy": "35240",
